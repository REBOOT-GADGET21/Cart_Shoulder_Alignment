<?xml version="1.0"?>
<robot name="rear_steer_cart" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find simulation)/urdf/cart_base.xacro"/>
  <xacro:include filename="$(find simulation)/urdf/wheel.xacro"/>
  <xacro:include filename="$(find simulation)/urdf/rgbd_camera.xacro"/>

  <xacro:cart_base prefix=""/>
  <link name="front_caster_link">
    <visual>
      <geometry><sphere radius="0.2"/></geometry>
      <material name="caster_green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision><geometry><sphere radius="0.2"/></geometry></collision>
  </link>
  <link name="rear_left_steering_link"/>
  <link name="rear_right_steering_link"/>
  <xacro:wheel prefix="" suffix="rear_left_wheel"/>
  <xacro:wheel prefix="" suffix="rear_right_wheel"/>
  <xacro:rgbd_camera prefix=""/>

  <joint name="front_caster_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.5 0.0 -0.14" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="rear_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_steering_link"/><origin xyz="-0.5 0.35 -0.14"/>
    <axis xyz="0 0 1"/><limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
  </joint>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_steering_link"/><child link="rear_left_wheel"/>
    <origin rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="rear_right_steering_joint" type="revolute">
    <parent link="base_link"/><child link="rear_right_steering_link"/>
    <origin xyz="-0.5 -0.35 -0.14"/><axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="rear_right_steering_link"/><child link="rear_right_wheel"/>
    <origin rpy="1.5708 0 0"/><axis xyz="0 0 1"/>
  </joint>
</robot>
