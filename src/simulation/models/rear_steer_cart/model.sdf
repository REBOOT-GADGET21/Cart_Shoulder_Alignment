<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- x forward, y left, z up.  This is the Gazebo model spawned by cart_only. -->
  <model name="rear_steer_cart">
    <link name="base_link">
      <!-- Body bottom is z=0.24. It covers 0.16 m of each 0.40 m wheel. -->
      <pose>0 0 0.34 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.35</ixx><iyy>1.25</iyy><izz>1.4</izz></inertia></inertial>
      <visual name="body_visual">
        <geometry><box><size>1.2 0.6 0.2</size></box></geometry>
        <material><ambient>0.05 0.2 0.8 1</ambient><diffuse>0.08 0.35 0.95 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <collision name="body_collision"><geometry><box><size>1.2 0.6 0.2</size></box></geometry></collision>
    </link>

    <!-- Passive front ball caster: it has no motor command. -->
    <link name="front_caster_link">
      <pose relative_to="base_link">0.5 0 -0.14 0 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.2</radius></sphere></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 1 0 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <collision name="caster_collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
    </link>

    <!-- Two separate powered rear wheel modules, not one shared wheel. -->
    <link name="rear_left_steering_link">
      <pose relative_to="base_link">-0.5 0.35 -0.14 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="left_motor_mount"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.16 0.12 0.20</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
    </link>
    <link name="rear_right_steering_link">
      <pose relative_to="base_link">-0.5 -0.35 -0.14 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="right_motor_mount"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>0.16 0.12 0.20</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose relative_to="rear_left_steering_link">0 0 0 1.5708 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia></inertial>
      <visual name="rear_left_visual">
        <geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="rear_left_collision"><geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry></collision>
    </link>
    <link name="rear_right_wheel">
      <pose relative_to="rear_right_steering_link">0 0 0 1.5708 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia></inertial>
      <visual name="rear_right_visual">
        <geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="rear_right_collision"><geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry></collision>
    </link>

    <!-- Matches params_setting.json: rear-centre mount, 0.60 m above base_link, 40 deg down. -->
    <link name="camera_link"><pose relative_to="base_link">-0.5 0 0.6 0 -0.6981317 0</pose></link>
    <link name="camera_optical_frame"/>

    <joint name="front_caster_joint" type="ball"><parent>base_link</parent><child>front_caster_link</child></joint>
    <joint name="rear_left_steering_joint" type="revolute"><parent>base_link</parent><child>rear_left_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper></limit></axis></joint>
    <joint name="rear_right_steering_joint" type="revolute"><parent>base_link</parent><child>rear_right_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper></limit></axis></joint>
    <joint name="rear_left_wheel_joint" type="revolute"><parent>rear_left_steering_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>rear_right_steering_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <joint name="camera_optical_joint" type="fixed"><parent>camera_link</parent><child>camera_optical_frame</child></joint>
  </model>
</sdf>
