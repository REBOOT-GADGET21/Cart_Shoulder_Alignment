<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- x forward, y left, z up.  This is the Gazebo model spawned by cart_only. -->
  <model name="rear_steer_cart">
    <link name="base_link">
      <!-- Body bottom is z=0.24. It covers 0.16 m of each 0.40 m wheel. -->
      <pose>0 0 0.34 0 0 0</pose>
      <inertial><mass>10</mass><inertia><ixx>0.35</ixx><iyy>1.25</iyy><izz>1.4</izz></inertia></inertial>
      <visual name="body_visual">
        <geometry><box><size>1.2 0.6 0.2</size></box></geometry>
        <material><ambient>0.05 0.2 0.8 1</ambient><diffuse>0.08 0.35 0.95 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <collision name="body_collision"><geometry><box><size>1.2 0.6 0.2</size></box></geometry></collision>
      <visual name="left_motor_mount"><pose>-0.5 0.31 -0.10 0 0 0</pose><geometry><box><size>0.18 0.12 0.20</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      <visual name="right_motor_mount"><pose>-0.5 -0.31 -0.10 0 0 0</pose><geometry><box><size>0.18 0.12 0.20</size></box></geometry><material><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
    </link>

    <!-- Small passive front ball caster: no motor and no commanded joint. -->
    <link name="front_caster_link">
      <pose relative_to="base_link">0.5 0 -0.26 0 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="caster_visual">
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0 0.8 0 1</ambient><diffuse>0 1 0 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <collision name="caster_collision"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
    </link>

    <!-- The small ball is held by a passive housing up to the chassis. -->
    <link name="front_caster_housing">
      <pose relative_to="base_link">0.5 0 -0.18 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="housing_visual"><geometry><cylinder><radius>0.11</radius><length>0.14</length></cylinder></geometry><material><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>

    <!-- Two fixed-direction powered rear wheels.  There is no yaw steering joint. -->
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.5 0.35 -0.14 0 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia></inertial>
      <visual name="rear_left_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="rear_left_collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry></collision>
    </link>
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.5 -0.35 -0.14 0 0 0</pose>
      <inertial><mass>1</mass><inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz></inertia></inertial>
      <visual name="rear_right_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="rear_right_collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.2</radius><length>0.10</length></cylinder></geometry></collision>
    </link>

    <!-- Matches params_setting.json: rear-centre mount, 0.60 m above base_link, 40 deg down. -->
    <link name="camera_link"><pose relative_to="base_link">-0.5 0 0.6 0 -0.6981317 0</pose></link>
    <link name="camera_optical_frame"/>

    <joint name="front_caster_housing_joint" type="fixed"><parent>base_link</parent><child>front_caster_housing</child></joint>
    <joint name="front_caster_joint" type="ball"><parent>base_link</parent><child>front_caster_link</child></joint>
    <!-- DART does not support SDF continuous joints here; large revolute limits provide equivalent wheel rotation. -->
    <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>50</effort><velocity>20</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis></joint>
    <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>50</effort><velocity>20</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis></joint>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <joint name="camera_optical_joint" type="fixed"><parent>camera_link</parent><child>camera_optical_frame</child></joint>

    <!-- ROS Float64 topics are bridged to these Gazebo Double angular-speed topics. -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_left_wheel_joint</joint_name><topic>/rear_left_wheel_speed_cmd</topic><use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rear_right_wheel_joint</joint_name><topic>/rear_right_wheel_speed_cmd</topic><use_force_commands>false</use_force_commands>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>20</update_frequency>
    </plugin>
  </model>
</sdf>
